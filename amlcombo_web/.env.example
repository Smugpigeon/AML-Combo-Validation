# Copy to .env and fill in. NEVER commit the real .env to git.
#
# ─── Domain ────────────────────────────────────────────────────────────
DOMAIN=amlcombo.org
BASE_URL=https://amlcombo.org

# ─── App environment ───────────────────────────────────────────────────
APP_ENV=prod

# ─── Secrets ───────────────────────────────────────────────────────────
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-long-random-string

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-fernet-key-urlsafe-b64-32bytes

# ─── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=amlcombo
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=amlcombo

# ─── Rate limits ───────────────────────────────────────────────────────
DAILY_PATIENT_SUBMIT_LIMIT=10
MAX_UPLOAD_BYTES=209715200            # 200 MB
